#!/bin/bash
# usecomputer-wsl
# v4.0 - Universal WSL to Windows Bridge
# ----------------------------------------------------------------------------------
# Transparently passes all Anthropic Computer Use commands from WSL to the native 
# Windows 'usecomputer' executable, mapping any output paths to Windows format seamlessly.

args=()

for arg in "$@"; do
    # If the argument looks like a relative or absolute file path intended for output,
    # translate it to a Windows UNC path so the native binary can write to WSL directly.
    if [[ "$arg" == *.png ]] || [[ "$arg" == *.jpg ]] || [[ "$arg" == *.json ]]; then
        win_path=$(wslpath -w "$arg" 2>/dev/null)
        if [[ -n "$win_path" ]]; then
            args+=("$win_path")
        else
            args+=("$arg")
        fi
    else
        args+=("$arg")
    fi
done

# Execute seamlessly on the Windows host using cmd.exe for safe parsing
/mnt/c/Windows/system32/cmd.exe /c npx usecomputer "${args[@]}"
