#!/bin/bash
# usecomputer-wsl
# v3.0 - Simplified bridge using Windows cmd.exe

COMMAND="$1"

if [[ "$COMMAND" == "screenshot" ]] && [[ -n "$2" ]]; then
    TARGET_FILE="$2"
    shift
    shift
    WIN_TEMP_NAME="wsl-bridge-shot.png"
    # Capture to Windows TEMP using cmd.exe
    /mnt/c/Windows/system32/cmd.exe /c "npx usecomputer screenshot %TEMP%\\$WIN_TEMP_NAME $@"
    
    # Move back to WSL
    cp "/mnt/c/Users/hardi/AppData/Local/Temp/$WIN_TEMP_NAME" "$TARGET_FILE" 2>/dev/null
    
    # Return standard JSON back to the agent
    echo "{\"path\": \"$TARGET_FILE\", \"status\": \"success\"}"
else
    # For click, type, press: forward arguments via standard cmd.exe. 
    # Do NOT use complex JSON here. Use simple flags (e.g. click -x 10 -y 10).
    /mnt/c/Windows/system32/cmd.exe /c npx usecomputer "$@"
fi
